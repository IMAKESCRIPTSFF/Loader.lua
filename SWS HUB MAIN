local loaded={}
local cards={}

local function loadScript(data,b)
    if loaded[data.Name] then
        status.Text="Already loaded: "..data.Name
        return
    end

    if not data.Universal and game.PlaceId~=data.PlaceId then
        status.Text="WRONG GAME: "..data.Name
        return
    end

    status.Text="Loading: "..data.Name
    b.Text="LOADING..."

    task.spawn(function()
        local ok,src=pcall(function()
            return game:HttpGet(data.URL)
        end)

        if not ok or type(src)~="string" or src=="" then
            status.Text="Download failed: "..tostring(src)
            b.Text="LOAD"
            return
        end

        local compiler=loadstring

        if type(compiler)~="function" then
            status.Text="loadstring unavailable"
            b.Text="LOAD"
            return
        end

        local compileOk,fn,compileErr=pcall(function()
            return compiler(src)
        end)

        if not compileOk then
            status.Text="Compiler error: "..tostring(fn)
            b.Text="LOAD"
            return
        end

        if type(fn)~="function" then
            status.Text="Compilation failed: "..tostring(compileErr)
            b.Text="LOAD"
            return
        end

        local runOk,err=pcall(fn)

        if runOk then
            loaded[data.Name]=true
            status.Text="Loaded: "..data.Name
            b.Text="LOADED"
        else
            status.Text="Execution error: "..tostring(err)
            b.Text="LOAD"
        end
    end)
end

